<Window x:Class="VideoPlayer.ServicesSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Services"
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F1118"
        Foreground="#E7E9F1"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Instrument Sans</FontFamily>

        <!-- Dark text input (shared look for TextBox + PasswordBox) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height"                      Value="38"/>
            <Setter Property="Background"                  Value="#08FFFFFF"/>
            <Setter Property="Foreground"                  Value="#E7E9F1"/>
            <Setter Property="CaretBrush"                  Value="#E7E9F1"/>
            <Setter Property="BorderBrush"                 Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="Padding"                     Value="12,0"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height"                      Value="38"/>
            <Setter Property="Background"                  Value="#08FFFFFF"/>
            <Setter Property="Foreground"                  Value="#E7E9F1"/>
            <Setter Property="CaretBrush"                  Value="#E7E9F1"/>
            <Setter Property="BorderBrush"                 Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="Padding"                     Value="12,0"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7D97FF"/>
            <Setter Property="Foreground" Value="#0F1118"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8FA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceButton" TargetType="Button">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Foreground" Value="#E7E9F1"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#848B9F"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E7E9F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Plex Media Server" FontSize="17" FontWeight="SemiBold" Foreground="#EEF1FB"/>
        </StackPanel>

        <!-- Server address -->
        <TextBlock Grid.Row="1" Text="Server address" FontSize="12" Foreground="#848B9F" Margin="2,0,0,6"/>
        <TextBox Grid.Row="2" x:Name="ServerBox" Style="{StaticResource DarkTextBox}"/>
        <TextBlock Grid.Row="2" x:Name="ServerPlaceholder"
                   Text="http://192.168.1.50:32400"
                   Foreground="#565C6D" FontSize="13" Margin="13,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>

        <!-- Token -->
        <TextBlock Grid.Row="3" Text="Plex token (X-Plex-Token)" FontSize="12" Foreground="#848B9F" Margin="2,14,0,6"/>
        <PasswordBox Grid.Row="4" x:Name="TokenBox" Style="{StaticResource DarkPasswordBox}"
                     PasswordChanged="TokenBox_PasswordChanged"/>

        <!-- Test row -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="TestButton" Content="Test connection"
                    Style="{StaticResource SurfaceButton}" Click="Test_Click"/>
            <TextBlock Grid.Column="1" x:Name="StatusText"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Foreground="#848B9F" TextWrapping="Wrap"/>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource TextButton}" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save"   Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
