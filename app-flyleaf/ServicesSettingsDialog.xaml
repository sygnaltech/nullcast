<Window x:Class="VideoPlayer.ServicesSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Height="560" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F1118"
        Foreground="#E7E9F1"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Same deal as the main window: the system caption paints light chrome that clashes badly
         with Indigo Slate, so the dialog draws its own black strip. NoResize means there is no
         resize border to reserve, hence ResizeBorderThickness 0. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Instrument Sans</FontFamily>

        <!-- Dark text input (shared look for TextBox + PasswordBox) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height"                      Value="38"/>
            <Setter Property="Background"                  Value="#08FFFFFF"/>
            <Setter Property="Foreground"                  Value="#E7E9F1"/>
            <Setter Property="CaretBrush"                  Value="#E7E9F1"/>
            <Setter Property="BorderBrush"                 Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="Padding"                     Value="12,0"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height"                      Value="38"/>
            <Setter Property="Background"                  Value="#08FFFFFF"/>
            <Setter Property="Foreground"                  Value="#E7E9F1"/>
            <Setter Property="CaretBrush"                  Value="#E7E9F1"/>
            <Setter Property="BorderBrush"                 Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="Padding"                     Value="12,0"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="FontSize"                    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7D97FF"/>
            <Setter Property="Foreground" Value="#0F1118"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8FA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceButton" TargetType="Button">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Foreground" Value="#E7E9F1"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#848B9F"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E7E9F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Caption strip (mirrors the main window's) ──
             Close only; a fixed-size dialog has nothing to minimise or maximise. -->
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width"      Value="46"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9BA2B5"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab strip ──
             Underlined tabs rather than folder tabs: the default TabItem chrome is light grey
             and can't be recoloured without a full template anyway. -->
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                <!-- -1 bottom margin drops each tab's accent underline onto the
                                     hairline instead of leaving a 1px gap under it. -->
                                <TabPanel IsItemsHost="True" Background="Transparent"
                                          Margin="0,0,0,-1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                              Margin="0,20,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#848B9F"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Margin="0,0,22,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" ContentSource="Header"
                                              Margin="0,0,0,10"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            <Border x:Name="Underline" Grid.Row="1" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#EEF1FB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Background" Value="#7D97FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"  Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="#E7E9F1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label above an input -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#848B9F"/>
            <Setter Property="Margin"     Value="2,14,0,6"/>
        </Style>

        <!-- Explanatory paragraph under a heading or a toggle -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#848B9F"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- caption strip -->
            <RowDefinition Height="*"/>     <!-- body -->
        </Grid.RowDefinitions>

        <!-- Caption strip: title left, close right. Everything but the button is caption, so
             the strip drags the dialog. -->
        <Border Grid.Row="0" Background="#0F1118" Height="32">
            <Grid>
                <TextBlock Text="Settings" Margin="14,0,0,0" FontSize="12"
                           Foreground="#E7E9F1"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CaptionCloseButton}"
                        Click="Cancel_Click" ToolTip="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" SnapsToDevicePixels="True"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,10,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- tabs -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="SettingsTabs"
                        Style="{StaticResource SettingsTabControl}">

                <!-- ══════════ General ══════════ -->
                <TabItem Header="General" Style="{StaticResource SettingsTabItem}">
                    <StackPanel>
                        <CheckBox x:Name="PinAllDesktopsCheck"
                                  Content="Show on all virtual desktops"
                                  Foreground="#E7E9F1" FontSize="13"
                                  Margin="2,0,0,0"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,6,0,0"
                                   Text="The player window follows you between virtual desktops instead of staying on the one it was opened on. Leave this on unless you deliberately want Nullcast confined to a single desktop."/>
                    </StackPanel>
                </TabItem>

                <!-- ══════════ Plex Media Server ══════════ -->
                <TabItem Header="Plex Media Server" Style="{StaticResource SettingsTabItem}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Point Nullcast at a Plex Media Server to browse and play its libraries from the Plex tab. Optional — leave the address blank to disable Plex."/>

                        <TextBlock Text="Server address" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox x:Name="ServerBox" Style="{StaticResource DarkTextBox}"/>
                            <TextBlock x:Name="ServerPlaceholder"
                                       Text="http://192.168.1.50:32400"
                                       Foreground="#565C6D" FontSize="13" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Plex token (X-Plex-Token)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="TokenBox" Style="{StaticResource DarkPasswordBox}"
                                     PasswordChanged="TokenBox_PasswordChanged"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="TestButton" Content="Test connection"
                                    Style="{StaticResource SurfaceButton}" Click="Test_Click"/>
                            <TextBlock Grid.Column="1" x:Name="StatusText"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="12" Foreground="#848B9F" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- ══════════ Tether ══════════ -->
                <TabItem Header="Tether" Style="{StaticResource SettingsTabItem}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Provisioned app credential from Tether's “Register app…”. Used by every player to pull live cookies. Leave blank to use the built-in dev token."/>

                        <TextBlock Text="App ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TetherAppIdBox" Style="{StaticResource DarkTextBox}"/>

                        <TextBlock Text="Key (token)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="TetherTokenBox" Style="{StaticResource DarkPasswordBox}"
                                     PasswordChanged="TetherTokenBox_PasswordChanged"/>

                        <TextBlock Text="Dev token (fallback)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TetherDevTokenBox" Style="{StaticResource DarkTextBox}"/>
                        <CheckBox x:Name="TetherDevFallbackCheck" Content="Use dev token as a fallback"
                                  Foreground="#B7BCCB" FontSize="12" Margin="2,14,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Footer buttons — outside the tabs; Save commits every tab. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource TextButton}" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Save"   Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
