<Window x:Class="VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib.Controls.WPF"
        Title="Video Player"
        Icon="VideoPlayer.ico"
        Height="600" Width="900"
        WindowState="Normal"
        Background="Black"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- System color overrides for dark theme -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#1a1a1a"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#333333"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#ffffff"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"      Color="#4a4a4a"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"  Color="#ffffff"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"       Color="#888888"/>

        <!-- Full ControlTemplate — system color overrides alone aren't reliable on Windows 11
             for the dropdown popup container, so we own the entire visual tree here. -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon area — hidden by default; shown in submenus for text indent -->
                                <ContentPresenter x:Name="IconContent"
                                                 Grid.Column="0"
                                                 Width="22" Margin="3,0"
                                                 ContentSource="Icon"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed"/>
                                <!-- Header text -->
                                <ContentPresenter Grid.Column="1"
                                                 ContentSource="Header"
                                                 RecognizesAccessKey="True"
                                                 Margin="8,4"
                                                 VerticalAlignment="Center"/>
                                <!-- Keyboard shortcut label -->
                                <TextBlock x:Name="GestureText"
                                          Grid.Column="2"
                                          Text="{TemplateBinding InputGestureText}"
                                          Margin="20,4,8,4"
                                          Foreground="#888888"
                                          VerticalAlignment="Center"/>
                                <!-- Dropdown popup with explicit opaque background -->
                                <Popup x:Name="PART_Popup"
                                       Grid.Column="0" Grid.ColumnSpan="3"
                                       Placement="Bottom"
                                       HorizontalOffset="-1"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="False"
                                       Focusable="False">
                                    <Border Background="#1a1a1a"
                                            BorderBrush="#555555"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_Popup"  Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="PART_Popup"  Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="PART_Popup"  Property="Placement"  Value="Right"/>
                                <Setter TargetName="IconContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Margin"     Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Dark ComboBoxItem -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a4a4a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox (workspace selector) -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Background"  Value="#2a2a2a"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- Toggle button: closed-state appearance -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Bd"
                                                Background="#2a2a2a"
                                                BorderBrush="#555555"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="#aaaaaa"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected-item text -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,22,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="White"/>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#2a2a2a"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Menu (left) + Login status (right) -->
        <DockPanel x:Name="TopBar" Grid.Row="0" Background="#333" LastChildFill="False">
            <Menu x:Name="MenuBar" DockPanel.Dock="Left" Background="Transparent" Foreground="White" VerticalAlignment="Center">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open URL..." Click="OpenUrl_Click" InputGestureText="Ctrl+O"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </MenuItem>
            </Menu>

            <!-- Login status -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="UserDisplayName"
                           Foreground="#aaaaaa"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="ConnectButton"
                        Content="Connect to Playlist"
                        Click="Connect_Click"
                        Padding="8,3"
                        Background="#3a3a3a"
                        Foreground="White"
                        BorderBrush="#555"
                        FontSize="12"/>
                <Button x:Name="SignOutButton"
                        Content="Sign out"
                        Click="SignOut_Click"
                        Padding="8,3"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        FontSize="12"
                        Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: Video area (left) + Playlist column (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Video area -->
            <Grid x:Name="VideoContainer" Grid.Column="0" Background="Black"
                  AllowDrop="True"
                  DragOver="VideoArea_DragOver"
                  Drop="VideoArea_Drop"
                  MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
                <fl:FlyleafME x:Name="FlyleafPlayer" Background="Black"
                              KeyBindings="None"
                              ActivityTimeout="0"/>

                <!-- Loading/Status overlay -->
                <TextBlock x:Name="StatusText"
                           Text="Press Ctrl+O or File > Open URL to load a video"
                           Foreground="Gray"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Playlist column: content panel + collapse tab -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Playlist panel -->
                <Grid x:Name="PlaylistPanel"
                      Grid.Column="0"
                      Width="260"
                      Background="#1a1a1a"
                      Visibility="Collapsed"
                      AllowDrop="True"
                      DragOver="PlaylistArea_DragOver"
                      Drop="PlaylistArea_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Workspace selector -->
                    <Grid Grid.Row="0" Background="#2a2a2a">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkspaceCombo"
                                  Grid.Column="0"
                                  Margin="6,5,4,5"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="WorkspaceCombo_SelectionChanged"/>
                        <Button x:Name="RefreshButton"
                                Grid.Column="1"
                                Content="↻"
                                Width="28" Height="24"
                                Margin="0,0,6,0"
                                Background="#333"
                                Foreground="White"
                                BorderBrush="#555"
                                ToolTip="Refresh playlist"
                                Click="RefreshPlaylist_Click"/>
                    </Grid>

                    <!-- Error label (hidden normally) -->
                    <TextBlock x:Name="PlaylistErrorText"
                               Grid.Row="1"
                               Foreground="#ff6666"
                               FontSize="11"
                               Margin="8,4"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Bookmark list -->
                    <ListBox x:Name="PlaylistBox"
                             Grid.Row="2"
                             Background="#1a1a1a"
                             Foreground="White"
                             BorderThickness="0"
                             ItemsSource="{Binding PlaylistItems}"
                             SelectionChanged="PlaylistBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- Dark 6px scrollbar scoped to this ListBox only -->
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}">
                                <Setter Property="Width"      Value="6"/>
                                <Setter Property="MinWidth"   Value="6"/>
                                <Setter Property="Background" Value="#1a1a1a"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Grid Background="#1a1a1a" Width="6">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Height="0"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border x:Name="ThumbBd" Background="#444444" CornerRadius="3"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBd" Property="Background" Value="#555555"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Height="0"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background"                 Value="Transparent"/>
                                <Setter Property="Foreground"                 Value="White"/>
                                <Setter Property="Padding"                    Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3a3a3a"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2a2a2a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Content row -->
                                    <Grid Grid.Row="0" Margin="8,6,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding PositionLabel}"
                                                       FontSize="10"
                                                       Foreground="#888888"
                                                       Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPosition}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Completed indicator -->
                                        <TextBlock Grid.Column="1"
                                                   Text="✓"
                                                   Foreground="#44cc44"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Progress bar at bottom (always visible, green fill) -->
                                    <ProgressBar Grid.Row="1"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="4"
                                                 Margin="8,0,8,5"
                                                 IsHitTestVisible="False">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Background" Value="#2a2a2a"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Background" Value="#1a4a1a"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                    <Border x:Name="PART_Indicator" Background="#44aa44" HorizontalAlignment="Left" CornerRadius="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Collapse/expand tab strip -->
                <Border x:Name="PlaylistTab"
                        Grid.Column="1"
                        Width="18"
                        Background="#252525"
                        Visibility="Collapsed">
                    <Button x:Name="CollapseToggleButton"
                            Content="❮"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888888"
                            FontSize="11"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="CollapseToggle_Click"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Controls -->
        <Grid x:Name="ControlsBar" Grid.Row="2" Background="#222" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Play/Pause Button -->
            <Button x:Name="PlayPauseButton"
                    Grid.Column="0"
                    Content="▶"
                    Width="40" Height="35"
                    Margin="10,0"
                    FontSize="16"
                    Click="PlayPause_Click"/>

            <!-- Progress Slider -->
            <Slider x:Name="ProgressSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="10,0"
                    Minimum="0"
                    Maximum="100"
                    IsMoveToPointEnabled="True"
                    PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                    PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>

            <!-- Time Display -->
            <TextBlock x:Name="TimeDisplay"
                       Grid.Column="2"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Text="00:00 / 00:00"/>

            <!-- Volume -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0">
                <TextBlock Text="🔊"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <Slider x:Name="VolumeSlider"
                        Width="80"
                        VerticalAlignment="Center"
                        Margin="5,0,10,0"
                        Minimum="0"
                        Maximum="200"
                        Value="100"
                        IsMoveToPointEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenUrlCommand}"/>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
    </Window.InputBindings>
</Window>
