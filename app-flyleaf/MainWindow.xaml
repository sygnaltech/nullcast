<Window x:Class="VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        Title="Nullcast"
        Icon="VideoPlayer.ico"
        Height="600" Width="900"
        WindowState="Normal"
        Background="{DynamicResource BgAppBrush}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        MouseMove="Window_MouseMove"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Window.Resources>
        <!-- ══════════════════════════════════════════════════════
             Indigo Slate palette (from reference design 1b)
             ══════════════════════════════════════════════════════ -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Instrument Sans</FontFamily>

        <!-- true → Visible, false → Collapsed (Plex drill-in chevron) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="BgAppBrush"         Color="#0F1118"/>
        <SolidColorBrush x:Key="BgMenuBrush"        Color="#151826"/>
        <SolidColorBrush x:Key="BgControlsBrush"    Color="#141726"/>
        <SolidColorBrush x:Key="AccentBrush"        Color="#7D97FF"/>
        <SolidColorBrush x:Key="AccentLightBrush"   Color="#9DB0FF"/>
        <SolidColorBrush x:Key="AccentTintBrush"    Color="#217D97FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E7E9F1"/>
        <SolidColorBrush x:Key="TextBrightBrush"    Color="#EEF1FB"/>
        <SolidColorBrush x:Key="TextMutedBrush"     Color="#848B9F"/>
        <SolidColorBrush x:Key="TextDimBrush"       Color="#565C6D"/>
        <SolidColorBrush x:Key="HairlineBrush"      Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush"         Color="#21FFFFFF"/>

        <!-- System color overrides for dark theme -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#151826"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}"        Color="#0F1118"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"       Color="#E7E9F1"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"      Color="#7D97FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"  Color="#0F1118"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"       Color="#848B9F"/>

        <!-- Full ControlTemplate — system color overrides alone aren't reliable on Windows 11
             for the dropdown popup container, so we own the entire visual tree here. -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E7E9F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon area — hidden by default; shown in submenus for text indent -->
                                <ContentPresenter x:Name="IconContent"
                                                 Grid.Column="0"
                                                 Width="18" Margin="10,0,0,0"
                                                 ContentSource="Icon"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed"/>
                                <!-- Check glyph for IsCheckable toggle items (shown when IsChecked) -->
                                <TextBlock x:Name="CheckGlyph"
                                           Grid.Column="0"
                                           Text="✓" FontSize="12" FontWeight="Bold"
                                           Width="18" Margin="10,0,0,0"
                                           Foreground="#7D97FF"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Visibility="Collapsed"/>
                                <!-- Header text -->
                                <ContentPresenter Grid.Column="1"
                                                 ContentSource="Header"
                                                 RecognizesAccessKey="True"
                                                 Margin="12,8"
                                                 VerticalAlignment="Center"/>
                                <!-- Keyboard shortcut label -->
                                <TextBlock x:Name="GestureText"
                                          Grid.Column="2"
                                          Text="{TemplateBinding InputGestureText}"
                                          Margin="24,8,14,8"
                                          Foreground="#848B9F"
                                          VerticalAlignment="Center"/>
                                <!-- Dropdown popup: translucent, rounded, matches the video menu -->
                                <Popup x:Name="PART_Popup"
                                       Grid.Column="0" Grid.ColumnSpan="3"
                                       Placement="Bottom"
                                       HorizontalOffset="-1" VerticalOffset="3"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False">
                                    <Border Background="#E61C1C22"
                                            BorderBrush="#1FFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="6"
                                            Margin="8"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_Popup"  Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="PART_Popup"  Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="PART_Popup"  Property="Placement"  Value="Right"/>
                                <Setter TargetName="IconContent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#565C6D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Margin"     Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separators INSIDE menus use this keyed style, not the implicit one above (WPF menus
             resolve MenuItem.SeparatorStyleKey). Dim + inset + vertical breathing room so items
             aren't smashed against a bright default line. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#12FFFFFF" Margin="12,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Dark ComboBoxItem -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#151826"/>
            <Setter Property="Foreground" Value="#E7E9F1"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#217D97FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox (workspace selector) -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground"  Value="#E7E9F1"/>
            <Setter Property="Background"  Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- Toggle button: closed-state appearance -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Bd"
                                                Background="#08FFFFFF"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="#848B9F"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected-item text -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,22,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#E7E9F1"/>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#151826"
                                        BorderBrush="#2A3042"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Underline tab button (Playlist / History) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#848B9F"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="2,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical sidebar tab: label rotated 90° with a 3px left accent bar when active.
             Active state is driven in code by StyleTab (Foreground + BorderBrush), same as the
             old horizontal tabs — here BorderBrush paints the left bar instead of an underline. -->
        <Style x:Key="VerticalTabButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#848B9F"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="9,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill segment button (Plex library selector: Movies / TV / Search) -->
        <Style x:Key="PlexSegment" TargetType="Button">
            <Setter Property="Background"  Value="#08FFFFFF"/>
            <Setter Property="Foreground"  Value="#848B9F"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,0,7,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="13,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small surface icon button (refresh, etc.) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"  Value="#08FFFFFF"/>
            <Setter Property="Foreground"  Value="#848B9F"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category selector face: surface box with a label + chevron (opens a filter popup) -->
        <Style x:Key="CategoryToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E7E9F1"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                BorderThickness="1" CornerRadius="8" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#848B9F"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7D97FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent pill button (Connect to Playlist) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"  Value="#7D97FF"/>
            <Setter Property="Foreground"  Value="#0F1118"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8FA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only button (Sign out) -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#848B9F"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E7E9F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin bar slider: rounded track, indigo fill, round white thumb -->
        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Height sets the clickable band; the visible bar stays 4px -->
                        <Grid VerticalAlignment="Center" Height="44" Background="Transparent">
                            <Border Height="4" CornerRadius="3" Background="#21FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- Transparent full-height wrapper = tall hit area -->
                                                <Border Background="Transparent">
                                                    <Border Height="4" CornerRadius="3" Background="#7D97FF" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- 13x44 transparent grab area around a 13px dot -->
                                                <Border Width="13" Height="44" Background="Transparent">
                                                    <Border Width="13" Height="13" CornerRadius="7" Background="#FFFFFF"
                                                            VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List item: rounded card + left accent bar for the selected (playing) row -->
        <Style x:Key="ListItemContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground"                 Value="#E7E9F1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Margin"                     Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <Grid>
                                <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                        Margin="0,13" CornerRadius="2" Background="#7D97FF"
                                        Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#217D97FF"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════
             Thin dark scrollbar — the house style. REQUIRED on every
             scrollable list (see STYLE-GUIDE.md). Apply per-list with:
               <ListBox.Resources>
                 <Style TargetType="{x:Type ScrollBar}"
                        BasedOn="{StaticResource ThinDarkScrollBar}"/>
               </ListBox.Resources>
             ══════════════════════════════════════════════════════ -->
        <Style x:Key="ThinDarkScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width"      Value="9"/>
            <Setter Property="MinWidth"   Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="9">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" Background="#24FFFFFF" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#3DFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════
             Plex results — genre chip + two swappable views
             (compact list vs. poster tiles). Swapped in code-behind
             by ApplyPlexViewMode(); toggled from the toolbar above
             the list and remembered in settings.
             ══════════════════════════════════════════════════════ -->

        <!-- One rounded genre/category chip -->
        <DataTemplate x:Key="PlexGenreChip">
            <Border Background="#14FFFFFF" CornerRadius="4" Margin="0,4,4,0" Padding="6,2">
                <TextBlock Text="{Binding}" FontSize="10" Foreground="#B7BCCB"/>
            </Border>
        </DataTemplate>

        <!-- Compact list row: small poster · title / subtitle / meta / genres · drill chevron -->
        <DataTemplate x:Key="PlexListItemTemplate">
            <Grid Margin="11,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Leading art: small poster with an episode-number badge overlaid bottom-left.
                     The whole column collapses when there's neither a poster nor a badge. -->
                <Grid Grid.Column="0" Width="36" Height="54" Margin="0,0,11,0"
                      VerticalAlignment="Top"
                      Visibility="{Binding HasLeadArt, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="4" Background="#22000000" ClipToBounds="True"
                            Visibility="{Binding HasThumb, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding ThumbUrl, IsAsync=True}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border Background="#CC0F1118" CornerRadius="3" Padding="4,1"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"
                            Visibility="{Binding HasEpisodeBadge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding EpisodeBadge}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#9DB0FF"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="Wrap" FontSize="14" FontWeight="Medium"
                               LineHeight="19" Foreground="#E7E9F1"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12" Foreground="#848B9F" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding MetaLine}"
                               FontSize="12" Foreground="#7D97FF" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TagLine}"
                               FontSize="11" Foreground="#848B9F" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#565C6D"
                           VerticalAlignment="Center" Margin="8,0,4,0"
                           Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- Poster tile: artwork · title · subtitle/meta · genre chips.
             Width is tuned so two tiles fit the 325px sidebar (allowing for the
             9px scrollbar) and more columns appear in the full-screen browse mode. -->
        <DataTemplate x:Key="PlexTileItemTemplate">
            <Grid Width="134" Margin="6,6,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Poster (2:3) with placeholder + drill badge -->
                <Border Grid.Row="0" Height="200" CornerRadius="8"
                        Background="#1AFFFFFF" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="🎬" FontSize="34" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding ThumbUrl, IsAsync=True}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasThumb, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- Drill-in badge for shows/seasons -->
                        <Border Background="#B30F1118" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="›" FontSize="15" Foreground="#E7E9F1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Border>
                        <!-- Episode-number badge (bottom-left) -->
                        <Border Background="#CC0F1118" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                Visibility="{Binding HasEpisodeBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EpisodeBadge}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#9DB0FF"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}"
                           FontSize="13" FontWeight="Medium" Foreground="#E7E9F1"
                           Margin="1,7,1,0" TextWrapping="Wrap" MaxHeight="36"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="{Binding MetaLine}"
                           FontSize="11" Foreground="#7D97FF" Margin="1,3,1,0"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Genre chips -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Genres}"
                              Margin="1,2,1,0"
                              ItemTemplate="{StaticResource PlexGenreChip}"
                              Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Items panels: vertical list vs. wrapping tile grid -->
        <ItemsPanelTemplate x:Key="PlexListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PlexTilePanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- ══════════════════════════════════════════════════════
             Video right-click menu (YouTube-style, translucent)
             ══════════════════════════════════════════════════════ -->
        <Style x:Key="VideoMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Height="40" Padding="16,0" Margin="0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="HasDropShadow"      Value="False"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VideoMenuItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#E61C1C22" CornerRadius="12" Padding="6"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="VideoContextMenu" Style="{StaticResource VideoContextMenuStyle}">
            <MenuItem Header="Copy video URL" Click="CopyVideoUrl_Click">
                <MenuItem.Icon>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E6E6E6" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M10 13 a5 5 0 0 0 7.54 0.54 l3 -3 a5 5 0 0 0 -7.07 -7.07 l-1.72 1.71 M14 11 a5 5 0 0 0 -7.54 -0.54 l-3 3 a5 5 0 0 0 7.07 7.07 l1.71 -1.71"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy video URL at current time" Click="CopyVideoUrlAtTime_Click">
                <MenuItem.Icon>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#E6E6E6" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M10 13 a5 5 0 0 0 7.54 0.54 l3 -3 a5 5 0 0 0 -7.07 -7.07 l-1.72 1.71 M14 11 a5 5 0 0 0 -7.54 -0.54 l-3 3 a5 5 0 0 0 7.07 7.07 l1.71 -1.71"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Menu (left) + Login status (right) -->
        <Border x:Name="TopBar" Grid.Row="0" Background="#151826"
                BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Height="38">
                <Menu x:Name="MenuBar" DockPanel.Dock="Left" Background="Transparent"
                      Foreground="#848B9F" VerticalAlignment="Center" Margin="8,0,0,0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open URL..." Click="OpenUrl_Click" InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem x:Name="CookiesMenuItem"
                                  Header="Use _Edge cookies for private videos"
                                  IsCheckable="True"
                                  Click="ToggleBrowserCookies_Click"/>
                        <MenuItem x:Name="CookieFileMenuItem"
                                  Header="Load _cookies.txt file…"
                                  Click="LoadCookiesFile_Click"/>
                        <MenuItem x:Name="ClearCookieFileMenuItem"
                                  Header="Clear cookies.txt file"
                                  Click="ClearCookiesFile_Click"/>
                        <MenuItem x:Name="AutoPlayNextMenuItem"
                                  Header="_Auto-play next episode"
                                  IsCheckable="True"
                                  Click="ToggleAutoPlayNext_Click"/>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="Exit_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Login status -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Services / settings gear -->
                    <Button x:Name="ServicesButton"
                            Content="⚙"
                            Click="OpenServices_Click"
                            ToolTip="Services…"
                            Margin="0,0,16,0"
                            FontSize="17"
                            Foreground="#848B9F"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#E7E9F1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="UserDisplayName"
                               Foreground="#E7E9F1"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               FontSize="13"
                               Visibility="Collapsed"/>
                    <Button x:Name="ConnectButton"
                            Content="Connect to Playlist"
                            Click="Connect_Click"
                            Style="{StaticResource AccentButton}"/>
                    <Button x:Name="SignOutButton"
                            Content="Sign out"
                            Click="SignOut_Click"
                            Style="{StaticResource TextButton}"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="VersionLabel"
                               Foreground="#565C6D"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Video area (left) + Playlist column (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VideoColumn" Width="*"/>
                <ColumnDefinition x:Name="PanelColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Video area -->
            <Grid x:Name="VideoContainer" Grid.Column="0" Background="Black"
                  AllowDrop="True"
                  DragOver="VideoArea_DragOver"
                  Drop="VideoArea_Drop"
                  MouseLeftButtonDown="VideoArea_MouseLeftButtonDown"
                  MouseRightButtonUp="VideoArea_MouseRightButtonUp"
                  MouseWheel="VideoArea_MouseWheel">
                <fl:FlyleafHost x:Name="FlyleafPlayer" Background="Black"
                                MouseBindings="None" KeyBindings="None"
                                ToggleFullScreenOnDoubleClick="None"
                                OpenOnDrop="None" SwapOnDrop="None"/>

                <!-- Loading/Status overlay -->
                <TextBlock x:Name="StatusText"
                           Text="Press Ctrl+O or File > Open URL to load a video"
                           Foreground="#848B9F"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Up-next auto-play card (bottom-right). Shown at the very end of a TV episode
                     when another follows; counts down then auto-advances, cancelable. -->
                <Border x:Name="NextEpisodeOverlay" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                        Background="#F00F1118" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        CornerRadius="12" Padding="16,14" MaxWidth="360">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="UP NEXT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#848B9F" Margin="0,0,0,5"/>
                        <TextBlock x:Name="NextEpisodeTitle" FontSize="14" FontWeight="Medium"
                                   Foreground="#E7E9F1" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="NextEpisodeSub" FontSize="12"
                                   Foreground="#848B9F" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <!-- Circled countdown; click to play now -->
                            <Grid Width="44" Height="44" Cursor="Hand">
                                <Ellipse Stroke="#7D97FF" StrokeThickness="2" Fill="#217D97FF"/>
                                <TextBlock x:Name="NextEpisodeCount" Text="3"
                                           FontSize="18" FontWeight="SemiBold" Foreground="#E7E9F1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Click="NextEpisodeNow_Click" ToolTip="Play now" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock Text="Starting next episode…" FontSize="12" Foreground="#848B9F"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button Content="Cancel" Click="NextEpisodeCancel_Click"
                                    Style="{StaticResource TextButton}" FontSize="12"
                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Playlist column: content panel + collapse tab -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidePanelColumn" Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Side panel: tab header + swappable Playlist / History content -->
                <Border x:Name="SidePanel"
                        Grid.Column="0"
                        Width="366"
                        Background="#0F1118"
                        BorderBrush="#0FFFFFFF"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vertical tab strip (left edge). Labels rotated 90°; active tab gets an
                         accent left-bar + bright text via StyleTab. No internal divider — the
                         panel's own left border is the separator. Wheel-scrolls if a very short
                         window can't fit every tab (scrollbar hidden so no stray bar appears). -->
                    <Border Grid.Column="0" Background="#0F1118">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Vertical" Margin="0,12">
                                <Button x:Name="PlaylistTabButton" Content="Playlist"
                                        Click="ShowPlaylistTab_Click"
                                        Style="{StaticResource VerticalTabButton}"
                                        Foreground="#E7E9F1" BorderBrush="#7D97FF"/>
                                <Button x:Name="HistoryTabButton" Content="History"
                                        Click="ShowHistoryTab_Click"
                                        Style="{StaticResource VerticalTabButton}"/>
                                <Button x:Name="PlexTabButton" Content="Plex"
                                        Click="ShowPlexTab_Click"
                                        Style="{StaticResource VerticalTabButton}"/>
                                <Button x:Name="PodcastsTabButton" Content="Podcasts"
                                        Click="ShowPodcastsTab_Click"
                                        Style="{StaticResource VerticalTabButton}"/>
                                <Button x:Name="YtMusicTabButton" Content="YT Music"
                                        Click="ShowYtMusicTab_Click"
                                        Style="{StaticResource VerticalTabButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Playlist content (online bookmarks; requires sign-in) -->
                    <Grid x:Name="PlaylistContent"
                          Grid.Column="1"
                          AllowDrop="True"
                          DragOver="PlaylistArea_DragOver"
                          Drop="PlaylistArea_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                    <!-- Workspace selector -->
                    <Grid Grid.Row="0" Margin="20,16,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkspaceCombo"
                                  Grid.Column="0"
                                  Height="38"
                                  Margin="0,0,10,0"
                                  FontSize="13"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="WorkspaceCombo_SelectionChanged"/>
                        <Button x:Name="RefreshButton"
                                Grid.Column="1"
                                Content="↻"
                                Width="38" Height="38"
                                FontSize="15"
                                Style="{StaticResource IconButton}"
                                ToolTip="Refresh playlist"
                                Click="RefreshPlaylist_Click"/>
                    </Grid>

                    <!-- Error label (hidden normally) -->
                    <TextBlock x:Name="PlaylistErrorText"
                               Grid.Row="1"
                               Foreground="#ff6666"
                               FontSize="11"
                               Margin="8,4"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Bookmark list -->
                    <ListBox x:Name="PlaylistBox"
                             Grid.Row="2"
                             Background="Transparent"
                             Foreground="#E7E9F1"
                             BorderThickness="0"
                             Padding="8,2,8,8"
                             ItemsSource="{Binding PlaylistItems}"
                             SelectionChanged="PlaylistBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- House thin dark scrollbar (see STYLE-GUIDE.md) -->
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="ListItemContainer"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="11,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Content row -->
                                    <Grid Grid.Row="0" Margin="8,10,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       LineHeight="19"
                                                       Foreground="#E7E9F1"/>
                                            <TextBlock Text="{Binding PositionLabel}"
                                                       FontSize="12"
                                                       Foreground="#848B9F"
                                                       Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPosition}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Completed indicator -->
                                        <TextBlock Grid.Column="1"
                                                   Text="✓"
                                                   Foreground="#44cc44"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Progress bar at bottom (indigo fill) -->
                                    <ProgressBar Grid.Row="1"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="3"
                                                 Margin="8,0,8,4"
                                                 Background="#21FFFFFF"
                                                 IsHitTestVisible="False">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                    <Border x:Name="PART_Indicator" Background="#7D97FF" HorizontalAlignment="Left" CornerRadius="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                    <!-- end PlaylistContent -->

                    <!-- History content (local-only playback history) -->
                    <Grid x:Name="HistoryContent" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search box with placeholder -->
                        <Grid Grid.Row="0" Margin="20,16,20,10">
                            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                    BorderThickness="1" CornerRadius="8"/>
                            <TextBox x:Name="HistorySearchBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#E7E9F1"
                                     CaretBrush="#E7E9F1"
                                     BorderThickness="0"
                                     TextChanged="HistorySearch_TextChanged"/>
                            <TextBlock Text="Search history…"
                                       Foreground="#565C6D"
                                       Margin="13,0,0,0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=HistorySearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ListBox x:Name="HistoryBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 Foreground="#E7E9F1"
                                 BorderThickness="0"
                                 Padding="8,2,8,8"
                                 ItemContainerStyle="{StaticResource ListItemContainer}"
                                 ItemsSource="{Binding HistoryItems}"
                                 SelectionChanged="HistoryBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="11,10">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   LineHeight="19"
                                                   Foreground="#E7E9F1"/>
                                        <TextBlock Text="{Binding LastPlayedLabel}"
                                                   FontSize="12"
                                                   Foreground="#848B9F"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- end HistoryContent -->

                    <!-- Plex content (separate ecosystem — browse/search a Plex Media Server) -->
                    <Grid x:Name="PlexContent" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- library selector -->
                            <RowDefinition Height="Auto"/>  <!-- category dropdown -->
                            <RowDefinition Height="Auto"/>  <!-- filter / search box -->
                            <RowDefinition Height="Auto"/>  <!-- breadcrumb (TV drill) -->
                            <RowDefinition Height="Auto"/>  <!-- status / empty state -->
                            <RowDefinition Height="Auto"/>  <!-- view toggle toolbar -->
                            <RowDefinition Height="*"/>     <!-- results list -->
                        </Grid.RowDefinitions>

                        <!-- Library selector (Movies / TV Shows / Search) — buttons added in code -->
                        <WrapPanel x:Name="PlexLibraryBar"
                                   Grid.Row="0"
                                   Margin="20,14,16,2"
                                   Visibility="Collapsed"/>

                        <!-- Category selector (Views + Genres) with a type-to-filter popup -->
                        <Grid x:Name="PlexCategoryHost" Grid.Row="1" Margin="20,4,20,4"
                              Visibility="Collapsed">
                            <ToggleButton x:Name="PlexCategoryButton"
                                          Height="34"
                                          Content="All"
                                          Style="{StaticResource CategoryToggle}"
                                          Click="PlexCategoryButton_Click"/>
                            <Popup x:Name="PlexCategoryPopup"
                                   PlacementTarget="{Binding ElementName=PlexCategoryButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Width="{Binding ActualWidth, ElementName=PlexCategoryButton}"
                                   Closed="PlexCategoryPopup_Closed">
                                <Border Background="#151826" BorderBrush="#242A3D" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,8" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.5"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Filter box -->
                                        <Grid Grid.Row="0" Margin="4,4,4,6">
                                            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                                    BorderThickness="1" CornerRadius="6"/>
                                            <TextBox x:Name="PlexCategoryFilter"
                                                     Height="32"
                                                     VerticalContentAlignment="Center"
                                                     Padding="10,0"
                                                     FontSize="13"
                                                     Background="Transparent"
                                                     Foreground="#E7E9F1"
                                                     CaretBrush="#E7E9F1"
                                                     BorderThickness="0"
                                                     TextChanged="PlexCategoryFilter_TextChanged"
                                                     PreviewKeyDown="PlexCategoryFilter_PreviewKeyDown"/>
                                            <TextBlock Text="Filter categories…"
                                                       Foreground="#565C6D" Margin="11,0,0,0"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=PlexCategoryFilter}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <!-- Grouped, scrollable category list -->
                                        <ListBox x:Name="PlexCategoryList"
                                                 Grid.Row="1"
                                                 MaxHeight="320"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource ListItemContainer}"
                                                 SelectionChanged="PlexCategoryList_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                                            </ListBox.Resources>
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#565C6D"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="8,7,0,2"/>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" Margin="8,6"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Filter / search box with placeholder -->
                        <Grid Grid.Row="2" Margin="20,4,20,8">
                            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                    BorderThickness="1" CornerRadius="8"/>
                            <TextBox x:Name="PlexSearchBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#E7E9F1"
                                     CaretBrush="#E7E9F1"
                                     BorderThickness="0"
                                     TextChanged="PlexSearch_TextChanged"/>
                            <TextBlock x:Name="PlexSearchPlaceholder"
                                       Text="Filter titles…"
                                       Foreground="#565C6D"
                                       Margin="13,0,0,0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=PlexSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Breadcrumb (TV drill: Section › Show › Season) — crumbs added in code -->
                        <WrapPanel x:Name="PlexBreadcrumbBar"
                                   Grid.Row="3"
                                   Margin="20,0,16,8"
                                   Visibility="Collapsed"/>

                        <!-- Status / empty state (unconfigured, loading, no results).
                             The spinner shows only during async loads. -->
                        <Grid Grid.Row="4" Margin="20,4,20,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Indeterminate spinner (rotates only while visible) -->
                            <Grid x:Name="PlexSpinner" Grid.Column="0"
                                  Width="15" Height="15" Margin="0,0,8,0"
                                  VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Stroke="#2A3042" StrokeThickness="2"/>
                                <Ellipse Stroke="#7D97FF" StrokeThickness="2"
                                         StrokeDashArray="4 20" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <Trigger Property="IsVisible" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard Name="PlexSpinnerSb">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    From="0" To="360" Duration="0:0:0.85"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PlexSpinnerSb"/>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="PlexStatusText"
                                       Grid.Column="1"
                                       Foreground="#848B9F"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- View toggle (list vs. tiles) — right-aligned above the results -->
                        <StackPanel x:Name="PlexViewToolbar"
                                    Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,20,8"
                                    Visibility="Collapsed">
                            <Button x:Name="PlexListViewBtn"
                                    Style="{StaticResource IconButton}"
                                    Width="34" Height="28"
                                    FontFamily="Segoe UI Symbol" FontSize="14"
                                    Content="&#x2261;"
                                    ToolTip="List view"
                                    Margin="0,0,6,0"
                                    Click="PlexListView_Click"/>
                            <Button x:Name="PlexTileViewBtn"
                                    Style="{StaticResource IconButton}"
                                    Width="34" Height="28"
                                    FontFamily="Segoe UI Symbol" FontSize="14"
                                    Content="&#x25A6;"
                                    ToolTip="Tile view"
                                    Margin="0,0,6,0"
                                    Click="PlexTileView_Click"/>
                            <Button x:Name="PlexFullscreenViewBtn"
                                    Style="{StaticResource IconButton}"
                                    Width="34" Height="28"
                                    FontFamily="Segoe UI Symbol" FontSize="14"
                                    Content="&#x26F6;"
                                    ToolTip="Full-screen tiles (pauses playback)"
                                    Click="PlexFullscreenView_Click"/>
                        </StackPanel>

                        <!-- Results list — ItemTemplate + ItemsPanel swapped by ApplyPlexViewMode() -->
                        <ListBox x:Name="PlexResultsBox"
                                 Grid.Row="6"
                                 Background="Transparent"
                                 Foreground="#E7E9F1"
                                 BorderThickness="0"
                                 Padding="8,2,8,8"
                                 ItemContainerStyle="{StaticResource ListItemContainer}"
                                 ItemsSource="{Binding PlexItems}"
                                 ItemTemplate="{StaticResource PlexListItemTemplate}"
                                 ItemsPanel="{StaticResource PlexListPanel}"
                                 SelectionChanged="PlexResultsBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                            </ListBox.Resources>
                        </ListBox>
                    </Grid>
                    <!-- end PlexContent -->

                    <!-- Podcast content (Apple Podcasts search → episode list → audio playback) -->
                    <Grid x:Name="PodcastContent" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search box with placeholder -->
                        <Grid Grid.Row="0" Margin="20,16,20,10">
                            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                    BorderThickness="1" CornerRadius="8"/>
                            <TextBox x:Name="PodcastSearchBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#E7E9F1"
                                     CaretBrush="#E7E9F1"
                                     BorderThickness="0"
                                     KeyDown="PodcastSearch_KeyDown"/>
                            <TextBlock Text="Search podcasts…  (Enter)"
                                       Foreground="#565C6D"
                                       Margin="13,0,0,0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=PodcastSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Back to results (only visible when viewing a show's episodes) -->
                        <Button x:Name="PodcastBackButton"
                                Grid.Row="1"
                                Content="‹  Back to results"
                                Click="PodcastBack_Click"
                                HorizontalAlignment="Left"
                                Margin="20,0,20,6"
                                Padding="0"
                                FontSize="12"
                                Foreground="#7D97FF"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"/>

                        <!-- Status / empty state -->
                        <TextBlock x:Name="PodcastStatusText"
                                   Grid.Row="2"
                                   Foreground="#848B9F"
                                   FontSize="12"
                                   Margin="20,4,20,4"
                                   TextWrapping="Wrap"
                                   Text="Search Apple Podcasts to get started."/>

                        <!-- Results list (shows or episodes) -->
                        <ListBox x:Name="PodcastResultsBox"
                                 Grid.Row="3"
                                 Background="Transparent"
                                 Foreground="#E7E9F1"
                                 BorderThickness="0"
                                 Padding="8,2,8,8"
                                 ItemContainerStyle="{StaticResource ListItemContainer}"
                                 ItemsSource="{Binding PodcastItems}"
                                 SelectionChanged="PodcastResultsBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="11,9">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   LineHeight="19"
                                                   Foreground="#E7E9F1"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}"
                                                   FontSize="12"
                                                   Foreground="#848B9F"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- end PodcastContent -->

                    <!-- YT Music content (yt-dlp-backed: search / Liked + pinned playlists → tracks) -->
                    <Grid x:Name="YtMusicContent" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search box with placeholder -->
                        <Grid Grid.Row="0" Margin="20,16,20,10">
                            <Border Background="#08FFFFFF" BorderBrush="#1AFFFFFF"
                                    BorderThickness="1" CornerRadius="8"/>
                            <TextBox x:Name="YtMusicSearchBox"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="#E7E9F1"
                                     CaretBrush="#E7E9F1"
                                     BorderThickness="0"
                                     KeyDown="YtMusicSearch_KeyDown"/>
                            <TextBlock Text="Search YouTube Music…  (Enter)"
                                       Foreground="#565C6D"
                                       Margin="13,0,0,0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=YtMusicSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Toolbar: back to playlists (when in a track view) + pin a playlist -->
                        <Grid Grid.Row="1" Margin="20,0,20,6">
                            <Button x:Name="YtMusicBackButton"
                                    Content="‹  Back to playlists"
                                    Click="YtMusicBack_Click"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    FontSize="12"
                                    Foreground="#7D97FF"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"/>
                            <Button x:Name="YtMusicPinButton"
                                    Content="＋ Pin playlist"
                                    Click="YtMusicPin_Click"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    FontSize="12"
                                    Foreground="#848B9F"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Pin a YouTube Music playlist by its URL"/>
                        </Grid>

                        <!-- Status / empty state -->
                        <TextBlock x:Name="YtMusicStatusText"
                                   Grid.Row="2"
                                   Foreground="#848B9F"
                                   FontSize="12"
                                   Margin="20,4,20,4"
                                   TextWrapping="Wrap"
                                   Text="Your Liked Music and pinned playlists appear here. Search above, or pin a playlist."/>

                        <!-- Results list (playlists or tracks) -->
                        <ListBox x:Name="YtMusicResultsBox"
                                 Grid.Row="3"
                                 Background="Transparent"
                                 Foreground="#E7E9F1"
                                 BorderThickness="0"
                                 Padding="8,2,8,8"
                                 ItemContainerStyle="{StaticResource ListItemContainer}"
                                 ItemsSource="{Binding YtMusicItems}"
                                 SelectionChanged="YtMusicResultsBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="11,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       LineHeight="19"
                                                       Foreground="#E7E9F1"/>
                                            <TextBlock Text="{Binding DisplaySubtitle}"
                                                       FontSize="12"
                                                       Foreground="#848B9F"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- Drill chevron on playlist rows -->
                                        <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="#565C6D"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                                   Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- end YtMusicContent -->
                  </Grid>
                </Border>
                <!-- end SidePanel -->

                <!-- Collapse/expand tab strip -->
                <Border x:Name="PlaylistTab"
                        Grid.Column="1"
                        Width="18"
                        Background="#0F1118"
                        BorderBrush="#0FFFFFFF"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Button x:Name="CollapseToggleButton"
                            Content="❮"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#848B9F"
                            FontSize="11"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Click="CollapseToggle_Click"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Controls -->
        <Grid x:Name="ControlsBar" Grid.Row="2" Background="#141726" Height="74">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Top hairline -->
            <Border Grid.ColumnSpan="4" VerticalAlignment="Top" Height="1" Background="#0FFFFFFF"/>

            <!-- Transport: Previous · Play/Pause · Next -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0">

                <!-- Previous track / restart -->
                <Button x:Name="PrevButton"
                        Click="PrevButton_Click"
                        ToolTip="Previous (restart if &gt;3s in)"
                        Width="40" Height="40" Background="Transparent" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#C7CBD6" Data="M7 5 H9 V19 H7 Z M18 5 L9 12 L18 19 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Play/Pause Button (circular accent) -->
                <Button x:Name="PlayPauseButton"
                        Content="▶"
                        Width="52" Height="52"
                        Margin="6,0,6,0"
                        FontSize="17"
                        Foreground="#0F1118"
                        Click="PlayPause_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#7D97FF" CornerRadius="26">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7D97FF" BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#8FA6FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Next track -->
                <Button x:Name="NextButton"
                        Click="NextButton_Click"
                        ToolTip="Next"
                        Width="40" Height="40" Background="Transparent" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#C7CBD6" Data="M15 5 H17 V19 H15 Z M6 5 L15 12 L6 19 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- Progress Slider -->
            <Slider x:Name="ProgressSlider"
                    Grid.Column="1"
                    Style="{StaticResource BarSlider}"
                    VerticalAlignment="Center"
                    Margin="22,0"
                    Minimum="0"
                    Maximum="100"
                    IsMoveToPointEnabled="True"
                    PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                    PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>

            <!-- Time Display -->
            <TextBlock x:Name="TimeDisplay"
                       Grid.Column="2"
                       Foreground="#848B9F"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"
                       Text="00:00 / 00:00"/>

            <!-- Volume -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,22,0" VerticalAlignment="Center">

                <!-- Queue behaviour: Shuffle · Repeat · Autoplay (state-coloured toggles) -->
                <Button x:Name="ShuffleButton"
                        Click="ShuffleButton_Click"
                        ToolTip="Shuffle"
                        Width="34" Height="28" Margin="0,0,2,0"
                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ShuffleIcon" Stroke="#848B9F" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M16 3 H21 V8 M4 20 L21 3 M21 16 V21 H16 M15 15 L21 21 M4 4 L9 9"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="RepeatButton"
                        Click="RepeatButton_Click"
                        ToolTip="Repeat: off → all → one"
                        Width="34" Height="28" Margin="0,0,2,0"
                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="RepeatIcon" Stroke="#848B9F" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M17 1 L21 5 L17 9 M3 11 V9 A4 4 0 0 1 7 5 H21 M7 23 L3 19 L7 15 M21 13 V15 A4 4 0 0 1 17 19 H3"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="9" FontWeight="Bold"
                                   Foreground="#7D97FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Button x:Name="AutoplayButton"
                        Click="AutoplayButton_Click"
                        ToolTip="Autoplay — continue to the next track/episode automatically"
                        Width="34" Height="28" Margin="0,0,14,0"
                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="AutoplayGlyph" Text="&#x221E;" FontSize="19"
                               Foreground="#848B9F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Playback speed (cycles 1x → 1.25x → 1.5x → 1.75x → 2x) -->
                <Button x:Name="SpeedButton"
                        Content="1×"
                        Click="SpeedButton_Click"
                        ToolTip="Playback speed"
                        Width="40" Height="28"
                        Margin="0,0,16,0"
                        FontSize="13"
                        Foreground="#848B9F"
                        Background="Transparent"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SpBd" Background="#10FFFFFF" CornerRadius="6" Padding="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SpBd" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="#848B9F" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M11 5 6 9H3v6h3l5 4V5Z M15.5 8.5a5 5 0 0 1 0 7 M18.8 6a9 9 0 0 1 0 12"/>
                    </Canvas>
                </Viewbox>
                <Slider x:Name="VolumeSlider"
                        Style="{StaticResource BarSlider}"
                        Width="96"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Minimum="0"
                        Maximum="200"
                        Value="100"
                        IsMoveToPointEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <!-- Floating controls overlay for maximized/fullscreen. Lives in its own
             top-level window (Popup) so it renders above the Flyleaf D3D surface;
             ControlsBar is re-parented here at runtime and back to Row 2 for the
             normal-windowed docked bar. -->
        <Popup x:Name="OverlayControlsPopup"
               PlacementTarget="{Binding ElementName=VideoContainer}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               PopupAnimation="Fade"/>

        <!-- ══════════════════════════════════════════════════════
             Ctrl+K global search palette. A top-level Popup (like the
             controls overlay above) so it paints over the Flyleaf D3D
             surface. The inner Grid is sized to RootGrid so the dim
             scrim covers the whole window; the card is centered on top.
             ══════════════════════════════════════════════════════ -->
        <Popup x:Name="SearchPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               Focusable="True"
               PopupAnimation="Fade"
               Closed="SearchPopup_Closed">
            <Grid Width="{Binding ActualWidth, ElementName=RootGrid}"
                  Height="{Binding ActualHeight, ElementName=RootGrid}">
                <!-- Dim scrim: click anywhere outside the card to dismiss -->
                <Border x:Name="SearchScrim" Background="#99080A12"
                        MouseDown="SearchScrim_MouseDown"/>

                <!-- Palette card -->
                <Border Width="720" MaxHeight="600"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,-40,0,0"
                        Background="#171A28" CornerRadius="14"
                        BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search input -->
                        <Grid Grid.Row="0" Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Opacity="0.5"
                                       VerticalAlignment="Center" Margin="2,0,12,0"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         VerticalContentAlignment="Center"
                                         FontSize="17"
                                         Background="Transparent"
                                         Foreground="#EEF1FB"
                                         CaretBrush="#7D97FF"
                                         BorderThickness="0"
                                         TextChanged="SearchBox_TextChanged"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                                <TextBlock Text="Search playlists, Plex…"
                                           Foreground="#565C6D"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Column="2" Background="#0FFFFFFF" CornerRadius="4"
                                    Padding="7,3" VerticalAlignment="Center">
                                <TextBlock Text="Esc" FontSize="11" Foreground="#848B9F"/>
                            </Border>
                        </Grid>

                        <!-- Divider under the input -->
                        <Border Grid.Row="1" Height="1" Background="#0FFFFFFF"/>

                        <!-- Source tabs -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,10,14,4">
                            <StackPanel.Resources>
                                <!-- Underline "pill" tab: Tag carries the filter key -->
                                <Style x:Key="SearchTabStyle" TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#848B9F"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Padding" Value="12,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#12FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="SearchTabAll"       Tag="All"       Content="All"       Style="{StaticResource SearchTabStyle}" Click="SearchTab_Click"/>
                            <Button x:Name="SearchTabPlaylists" Tag="Playlist"  Content="Playlists" Style="{StaticResource SearchTabStyle}" Click="SearchTab_Click"/>
                            <Button x:Name="SearchTabPlex"      Tag="Plex"      Content="Plex"      Style="{StaticResource SearchTabStyle}" Click="SearchTab_Click"/>
                        </StackPanel>

                        <!-- Results / empty-state -->
                        <Grid Grid.Row="3" Margin="0,2,0,8">
                            <TextBlock x:Name="SearchStatusText"
                                       Text="Type to search your playlists and Plex library."
                                       Foreground="#565C6D" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="24" TextAlignment="Center" TextWrapping="Wrap"/>
                            <ListBox x:Name="SearchResultsBox"
                                     Background="Transparent"
                                     Foreground="#E7E9F1"
                                     BorderThickness="0"
                                     Padding="8,0,8,6"
                                     ItemContainerStyle="{StaticResource ListItemContainer}"
                                     PreviewMouseLeftButtonUp="SearchResult_Click"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinDarkScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="11,12,11,4">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#848B9F"/>
                                                    <TextBlock Text="{Binding ItemCount}"
                                                               FontSize="11" Foreground="#565C6D"
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="11,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Poster (Plex only; hidden otherwise) -->
                                            <Border Grid.Column="0" Width="36" Height="54" CornerRadius="4"
                                                    Margin="0,0,11,0" Background="#22000000" ClipToBounds="True"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding HasThumb, Converter={StaticResource BoolToVisibility}}">
                                                <Image Source="{Binding ThumbUrl, IsAsync=True}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap" FontSize="14" FontWeight="Medium"
                                                           LineHeight="19" Foreground="#E7E9F1"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12" Foreground="#848B9F" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Source badge pill -->
                                            <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="4"
                                                    Padding="7,3" VerticalAlignment="Center" Margin="8,0,2,0">
                                                <TextBlock Text="{Binding SourceBadge}" FontSize="10" Foreground="#B7BCCB"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenUrlCommand}"/>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding SearchCommand}"/>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
    </Window.InputBindings>
</Window>
