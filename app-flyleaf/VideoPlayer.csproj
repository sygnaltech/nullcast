<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoPlayer</RootNamespace>
    <AssemblyName>VideoPlayer</AssemblyName>
    <ApplicationIcon>VideoPlayer.ico</ApplicationIcon>
    <Product>Nullcast</Product>
    <AssemblyTitle>Nullcast</AssemblyTitle>
    <Description>Nullcast — a lightweight, client-side Windows video player.</Description>
    <Version>0.2.37</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="VideoPlayer.ico"/>
    <!-- Bundled Instrument Sans (SIL OFL 1.1) — embedded so the UI matches the
         Indigo Slate reference design on machines without the font installed. -->
    <Resource Include="Fonts\*.ttf"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="FFmpeg\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ship the font license alongside the binary (OFL redistribution). -->
    <Content Include="Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Telemetry config (PostHog). Copied next to the exe; edit + relaunch to change the key,
         no rebuild. PreserveNewest so a hand-edited output copy isn't clobbered by a rebuild. -->
    <Content Include="telemetry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlyleafLib" Version="3.10.2" />
    <PackageReference Include="FlyleafLib.Controls.WPF" Version="1.6.2" />
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.0.1" />
    <!-- Windows DPAPI for encrypting service secrets (Plex token) at rest. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Robust RSS/Atom parsing (incl. iTunes podcast namespace) for the podcast tab. -->
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <!-- Product analytics + failure telemetry (see Services/Telemetry.cs). Dormant until a
         PostHog project key is configured in services.json (analytics.api_key). -->
    <PackageReference Include="PostHog" Version="2.13.1" />
  </ItemGroup>

</Project>
